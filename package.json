{
  "name": "mechaburst",
  "private": true,
  "version": "1.0.0",
  "description": "MECHA BURST — official site (mechaburst.pages.dev)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "pnpm dlx serve out",
    "media": "node scripts/media.mjs && bash scripts/video.sh",
    "test": "node --test \"tests/*.test.mjs\"",
    "deploy": "pnpm run build && wrangler pages deploy out --project-name mechaburst --branch main"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@10.25.0"
}
